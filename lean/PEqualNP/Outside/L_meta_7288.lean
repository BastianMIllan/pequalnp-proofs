def W (a b c : Fin 13) : Finset (Fin 13) :=
  (((tbl.getD a.val []).getD b.val []).getD c.val []).toFinset

def Good (x2 x3 x4 x5 : Fin 13) (X : Finset (Fin 13)) : Prop :=
  (X.card = 4 ∧ ∀ l : Fin 13, (X.filter fun y => y - l ∈ DD).card ≤ 2) ∧ x2 ∈ X ∧ x3 ∈ X ∧
    (∀ y ∈ X, y - x4 ∉ DD) ∧ ∀ y ∈ X, y - x5 ∉ DD

theorem tableOK : ∀ a b c : Fin 13, a - 0 ∉ DD → a - c ∉ DD → b - 0 ∉ DD → b - c ∉ DD →
    Good a b 0 c (W a b c) := by
  unfold Good
  decide +kernel

theorem shift (x2 x3 x4 x5 t : Fin 13) (X : Finset (Fin 13)) (h : Good x2 x3 x4 x5 X) :
    Good (x2 + t) (x3 + t) (x4 + t) (x5 + t) (X.map (addRightEmbedding t)) := by
  obtain ⟨⟨hc, hl⟩, h2, h3, h4, h5⟩ := h
  refine ⟨⟨by rw [Finset.card_map, hc], fun l => ?_⟩, Finset.mem_map_of_mem _ h2,
    Finset.mem_map_of_mem _ h3, ?_, ?_⟩
  · rw [Finset.filter_map, Finset.card_map]
    refine le_trans (le_of_eq ?_) (hl (l - t))
    congr 1
    apply Finset.filter_congr
    intro y _
    simp only [Function.comp, addRightEmbedding_apply]
    rw [sub_sub_eq_add_sub]
  · intro y hy
    obtain ⟨z, hz, rfl⟩ := Finset.mem_map.1 hy
    simp only [addRightEmbedding_apply]
    rw [add_sub_add_right_eq_sub]
    exact h4 z hz
  · intro y hy
    obtain ⟨z, hz, rfl⟩ := Finset.mem_map.1 hy
    simp only [addRightEmbedding_apply]
    rw [add_sub_add_right_eq_sub]
    exact h5 z hz

theorem main : ∀ x2 x3 x4 x5 : Fin 13, x2 - x4 ∉ DD → x2 - x5 ∉ DD → x3 - x4 ∉ DD →
    x3 - x5 ∉ DD → ∃ X, Good x2 x3 x4 x5 X := by
  intro x2 x3 x4 x5 h1 h2 h3 h4
  have k := tableOK (x2 - x4) (x3 - x4) (x5 - x4) (by simpa using h1)
    (by rwa [sub_sub_sub_cancel_right]) (by simpa using h3) (by rwa [sub_sub_sub_cancel_right])
  have k2 := shift _ _ _ _ x4 _ k
  simp only [sub_add_cancel, zero_add] at k2
  exact ⟨_, k2⟩

end PEqualNP.Outside.L_meta_7288

