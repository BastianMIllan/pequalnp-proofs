set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem seg1 : ∀ a, (∀ c ∈ F, ClauseSat a c) → EntriesSat a B1 :=
  checkFirst_sound F kk 15 pw1 B1 (by decide +kernel)

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem seg2 : ∀ a, EntriesSat a B1 → False :=
  checkLast_sound B1 15 pw2 (by decide +kernel)

theorem refuted : ¬ FormulaSat F := by
  rintro ⟨a, ha⟩
  exact seg2 a (seg1 a ha)

-- A circuit with the negated inputs free reads the 8 inputs (x, not x): rows are those inputs.
theorem bits : ∀ r ∈ rows, (List.ofFn fun i : Fin 8 => r.testBit i) =
    List.ofFn (fun i : Fin 4 => r.testBit i) ++ List.ofFn fun i : Fin 4 => !(r.testBit i) := by decide +kernel

theorem tab : ∀ r ∈ rows, PEqualNP.MetaComplexity.tableIndex (fun i : Fin 4 => r.testBit i) = r % 16 := by decide +kernel

theorem lower (t : ℕ) (h : PEqualNP.Represents.HasLitSize 4 (fun x : Fin 4 → Bool => (1782 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t) : 6 ≤ t := by
  by_contra hlt
  obtain ⟨D, hD, hs, hr⟩ := h
  have hF : PEqualNP.MetaComplexity.FanInTwo D := by
    intro g hg
    have h1 : g.op ∈ ({PEqualNP.CircuitLowerBounds.GateOp.and, PEqualNP.CircuitLowerBounds.GateOp.or} : Set PEqualNP.CircuitLowerBounds.GateOp) ∧ g.inputs.length ≤ 2 := hD g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h1 ⊢
    exact ⟨h1.1.elim Or.inl (fun h2 => Or.inr (Or.inl h2)), h1.2⟩
  have hv := valid_ofCirc 8 5 gg (· ∈ rows) D hF (by have h0 : D.gates.length ≤ t := hs; omega) (fun r hm => by
    show D.eval (List.ofFn fun i : Fin 8 => r.testBit i) = _
    rw [bits r hm]
    refine (hr _).trans ?_
    show (1782 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex fun i : Fin 4 => r.testBit i) = (1782 : ℕ).testBit (r % 16)
    rw [tab r hm])
  obtain ⟨M, hM, hnf, hlx⟩ := exists_nf2 ⟨_, hv⟩
  exact refuted ⟨val 8 5 M, enc2_sat (by decide) hM hnf hlx⟩

end PEqualNP.Outside.V_meta_9657__k6

theorem PEqualNP.Outside.V_meta_9657__k6 : PEqualNP.Represents.HasLitSize 4 (fun x : Fin 4 → Bool => (1782 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) 6 ∧
  ∀ t : ℕ, PEqualNP.Represents.HasLitSize 4 (fun x : Fin 4 → Bool => (1782 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t → 6 ≤ t :=
  ⟨⟨PEqualNP.Outside.V_meta_9657__k6.C, by simp [PEqualNP.Outside.V_meta_9657__k6.C, PEqualNP.MetaComplexity.Monotone2], by decide, by decide +kernel⟩, PEqualNP.Outside.V_meta_9657__k6.lower⟩
