-- Points are 0..20, lines are 21..41. Point p lies on line 21 + l when (l - p) mod 21 is in
-- 0, 5, 7, 17, 20.
def inD (n : ℕ) : Bool := n == 0 || n == 5 || n == 7 || n == 17 || n == 20

def rel (u v : Fin 42) : Bool :=
  (decide (u.val < 21) && decide (21 ≤ v.val) && inD ((v.val + 21 - u.val) % 21)) ||
  (decide (v.val < 21) && decide (21 ≤ u.val) && inD ((u.val + 21 - v.val) % 21))

