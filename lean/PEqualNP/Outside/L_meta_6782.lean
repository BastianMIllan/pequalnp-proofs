def nxt (a b : Fin 42) : ℕ := (tbl.getD a.val []).getD b.val 0

def base (a b : Fin 42) : Bool := a == 0 && (b == 0 || b == 22)

def reach : ℕ → Fin 42 → Fin 42 → Bool
  | 0, a, b => base a b
  | n + 1, a, b => base a b || reach n (gf (nxt a b) a) (gf (nxt a b) b)

theorem left_ok : ∀ i : Fin 4, ∀ u : Fin 42, gb i.val (gf i.val u) = u := by decide +kernel
theorem right_ok : ∀ i : Fin 4, ∀ u : Fin 42, gf i.val (gb i.val u) = u := by decide +kernel
theorem rel_ok : ∀ i : Fin 4, ∀ u v : Fin 42, rel (gf i.val u) (gf i.val v) = rel u v := by
  decide +kernel
theorem nxt_lt : ∀ a b : Fin 42, nxt a b < 4 := by decide +kernel
theorem reach_ok : ∀ a b : Fin 42,
    (a == b || (decide (a.val < 21) && decide (21 ≤ b.val) && !rel a b)) = true →
      reach 8 a b = true := by
  decide +kernel
theorem adj_rel : ∀ u v : Fin 42, (u ≠ v ∧ ((u.val < 21 ∧ 21 ≤ v.val ∧
    (v.val + 21 - u.val) % 21 ∈ [0, 5, 7, 17, 20]) ∨ (v.val < 21 ∧ 21 ≤ u.val ∧
    (u.val + 21 - v.val) % 21 ∈ [0, 5, 7, 17, 20]))) ↔ rel u v = true := by
  decide +kernel

def perm (i : Fin 4) : Equiv.Perm (Fin 42) := ⟨gf i.val, gb i.val, left_ok i, right_ok i⟩

theorem main (G : SimpleGraph (Fin 42)) (h : ∀ u v : Fin 42, G.Adj u v ↔ rel u v = true) :
    ∀ (n : ℕ) (a b : Fin 42), reach n a b = true →
      ∃ φ : G ≃g G, φ a = 0 ∧ (φ b = 0 ∨ φ b = 22) := by
  have iso : ∀ i : Fin 4, ∃ ψ : G ≃g G, ∀ u, ψ u = gf i.val u := by
    intro i
    refine ⟨⟨perm i, ?_⟩, fun u => rfl⟩
    intro u v
    rw [h, h]
    change rel (gf i.val u) (gf i.val v) = true ↔ _
    rw [rel_ok]
  have hbase : ∀ a b : Fin 42, base a b = true →
      ∃ φ : G ≃g G, φ a = 0 ∧ (φ b = 0 ∨ φ b = 22) := by
    intro a b hb
    refine ⟨RelIso.refl _, ?_⟩
    simp only [base, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at hb
    exact hb
  intro n
  induction n with
  | zero =>
    intro a b hr
    exact hbase a b hr
  | succ n ih =>
    intro a b hr
    simp only [reach, Bool.or_eq_true] at hr
    rcases hr with hb | hr
    · exact hbase a b hb
    · obtain ⟨φ, h1, h2⟩ := ih _ _ hr
      obtain ⟨ψ, hψ⟩ := iso ⟨nxt a b, nxt_lt a b⟩
      refine ⟨ψ.trans φ, ?_, ?_⟩
      · change φ (ψ a) = 0
        rw [hψ]
        exact h1
      · change φ (ψ b) = 0 ∨ φ (ψ b) = 22
        rw [hψ]
        exact h2

theorem final (G : SimpleGraph (Fin 42)) (hG : ∀ u v : Fin 42, G.Adj u v ↔ rel u v = true) :
    (∀ v : Fin 42, ∃ φ : G ≃g G, φ v = 0) ∧ ∀ p l : Fin 42, (p : ℕ) < 21 → 21 ≤ (l : ℕ) →
      ¬ G.Adj p l → ∃ φ : G ≃g G, φ p = 0 ∧ φ l = 22 := by
  refine ⟨fun v => ?_, fun p l hp hl hn => ?_⟩
  · obtain ⟨φ, h1, _⟩ := main G hG 8 v v (reach_ok v v (by simp))
    exact ⟨φ, h1⟩
  · have hr : rel p l = false := by
      cases hc : rel p l
      · rfl
      · exact absurd ((hG p l).2 hc) hn
    obtain ⟨φ, h1, h2⟩ := main G hG 8 p l (reach_ok p l (by simp [hp, hl, hr]))
    refine ⟨φ, h1, ?_⟩
    rcases h2 with h2 | h2
    · have hpl : p = l := φ.injective (h1.trans h2.symm)
      subst hpl
      omega
    · exact h2

end PEqualNP.Outside.L_meta_6782

