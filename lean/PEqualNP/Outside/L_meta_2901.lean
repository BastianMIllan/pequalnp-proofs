theorem bool_id : ∀ a0 a1 a2 a3 a4 a5 a6 b0 b1 b2 b3 b4 b5 b6 : Bool,
    E1 a0 a1 a2 a3 a4 a5 a6 b0 b1 b2 b3 b4 b5 b6 =
      Inc.any (fun e => [a0, a1, a2, a3, a4, a5, a6].getD e.1 false &&
        [b0, b1, b2, b3, b4, b5, b6].getD e.2 false) := by
  decide +kernel

