def mkPerm (f g : Fin 21 → Fin 21) (h : ∀ x, g (f x) = x ∧ f (g x) = x) : Equiv.Perm (Fin 21) :=
  ⟨f, g, fun x => (h x).1, fun x => (h x).2⟩

theorem key (s : ℕ) (t : Fin 21) (r : ℕ) (f g h k : Fin 21 → Fin 21)
    (hok : (∀ x, g (f x) = x ∧ f (g x) = x) ∧ (∀ x, k (h x) = x ∧ h (k x) = x) ∧
      (∀ a b : Fin 21, (Pr (f a) (h b) ↔ Pr a b)))
    (hr : r ∈ L) (h4 : cl (insert t (bits s)) = (bits r).image f) :
    ∃ x8 ∈ L, ∃ (x9 : Equiv.Perm (Fin (21 : ℕ))) (x10 : Equiv.Perm (Fin (21 : ℕ))),
      (∀ (x11 x12 : Fin (21 : ℕ)), Pr (x9 x11) (x10 x12) ↔ Pr x11 x12) ∧
      cl (insert t (bits s)) = Finset.map (Equiv.toEmbedding x9) (bits x8) := by
  refine ⟨r, hr, mkPerm f g hok.1, mkPerm h k hok.2.1, fun a b => hok.2.2 a b, ?_⟩
  rw [Finset.map_eq_image]
  exact h4

