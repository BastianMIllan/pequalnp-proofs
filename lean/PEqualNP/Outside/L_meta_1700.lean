import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_1700
open PEqualNP.CircuitLowerBounds

def sem (z : List Bool) (D : List (List ℕ)) : Bool :=
  D.any (fun m => m.all (fun i => z.getD i false))

def dAnd (D1 D2 : List (List ℕ)) : List (List ℕ) :=
  D1.flatMap (fun m1 => D2.map (fun m2 => m1 ++ m2))

def isAO (g : Gate) : Bool :=
  match g.op with
  | GateOp.and => true
  | GateOp.or => true
  | _ => false

def symGate (g : Gate) (W : List (List (List ℕ))) : List (List ℕ) :=
  match g.op with
  | GateOp.and => (g.inputs.map fun i => W.getD i []).foldr dAnd [[]]
  | _ => (g.inputs.map fun i => W.getD i []).foldr (fun a b => a ++ b) []

theorem sem_append (z : List Bool) (D1 D2 : List (List ℕ)) :
    sem z (D1 ++ D2) = (sem z D1 || sem z D2) := by
  simp [sem, List.any_append]

theorem sem_map (z : List Bool) (m : List ℕ) (D2 : List (List ℕ)) :
    sem z (D2.map (fun m2 => m ++ m2)) = ((m.all fun i => z.getD i false) && sem z D2) := by
  induction D2 with
  | nil => simp [sem]
  | cons m2 D2 ih =>
    have e1 : sem z ((m2 :: D2).map (fun m2 => m ++ m2)) =
        (((m ++ m2).all fun i => z.getD i false) || sem z (D2.map (fun m2 => m ++ m2))) := rfl
    have e2 : sem z (m2 :: D2) = ((m2.all fun i => z.getD i false) || sem z D2) := rfl
    rw [e1, e2, ih, List.all_append]
    generalize (m.all fun i => z.getD i false) = a
    generalize (m2.all fun i => z.getD i false) = b
    generalize sem z D2 = c
    cases a <;> cases b <;> cases c <;> rfl

theorem sem_dAnd (z : List Bool) (D1 D2 : List (List ℕ)) :
    sem z (dAnd D1 D2) = (sem z D1 && sem z D2) := by
  induction D1 with
  | nil => rfl
  | cons m D1 ih =>
    have h1 : dAnd (m :: D1) D2 = D2.map (fun m2 => m ++ m2) ++ dAnd D1 D2 := by
      simp [dAnd]
    have h3 : sem z (m :: D1) = ((m.all fun i => z.getD i false) || sem z D1) := rfl
    rw [h1, sem_append, sem_map, ih, h3]
    generalize (m.all fun i => z.getD i false) = a
    generalize sem z D1 = b
    generalize sem z D2 = c
    cases a <;> cases b <;> cases c <;> rfl

theorem getD_sem (z : List Bool) (W : List (List (List ℕ))) :
    ∀ i : ℕ, (W.map (sem z)).getD i false = sem z (W.getD i []) := by
  induction W with
  | nil => intro i; simp [sem]
  | cons a W ih =>
    intro i
    cases i with
    | zero => simp
    | succ i => simpa using ih i

theorem and_sound (z : List Bool) (W : List (List (List ℕ))) (inputs : List ℕ) :
    (inputs.map fun i => (W.map (sem z)).getD i false).all id =
      sem z ((inputs.map fun i => W.getD i []).foldr dAnd [[]]) := by
  induction inputs with
  | nil => rfl
  | cons i inputs ih =>
    have e : sem z (((i :: inputs).map fun i => W.getD i []).foldr dAnd [[]]) =
        (sem z (W.getD i []) && sem z ((inputs.map fun i => W.getD i []).foldr dAnd [[]])) :=
      sem_dAnd z _ _
    rw [e, ← ih, ← getD_sem]
    rfl

theorem or_sound (z : List Bool) (W : List (List (List ℕ))) (inputs : List ℕ) :
    (inputs.map fun i => (W.map (sem z)).getD i false).any id =
      sem z ((inputs.map fun i => W.getD i []).foldr (fun a b => a ++ b) []) := by
  induction inputs with
  | nil => rfl
  | cons i inputs ih =>
    have e : sem z (((i :: inputs).map fun i => W.getD i []).foldr (fun a b => a ++ b) []) =
        (sem z (W.getD i []) || sem z ((inputs.map fun i => W.getD i []).foldr (fun a b => a ++ b) [])) :=
      sem_append z _ _
    rw [e, ← ih, ← getD_sem]
    rfl

theorem gate_sound (z : List Bool) (W : List (List (List ℕ))) (g : Gate) (h : isAO g = true) :
    g.op.eval (g.inputs.map fun i => (W.map (sem z)).getD i false) = sem z (symGate g W) := by
  obtain ⟨op, inputs⟩ := g
  cases op
  · exact and_sound z W inputs
  · exact or_sound z W inputs
  · exact absurd h Bool.false_ne_true
  · exact absurd h Bool.false_ne_true
  · exact absurd h Bool.false_ne_true

theorem wires_sound (z : List Bool) (gates : List Gate) :
    ∀ W : List (List (List ℕ)), gates.all isAO = true →
    gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (W.map (sem z)) =
      (gates.foldl (fun W g => W ++ [symGate g W]) W).map (sem z) := by
  induction gates with
  | nil => intro W _; rfl
  | cons g gates ih =>
    intro W hg
    simp only [List.all_cons, Bool.and_eq_true] at hg
    simp only [List.foldl_cons]
    rw [gate_sound z W g hg.1]
    have e : W.map (sem z) ++ [sem z (symGate g W)] = (W ++ [symGate g W]).map (sem z) := by simp
    rw [e]
    exact ih _ hg.2

theorem getD_last {α : Type} (L : List α) (v d : α) (n : ℕ) (h : L.length = n) :
    (L ++ [v]).getD n d = v := by
  subst h
  induction L with
  | nil => rfl
  | cons a L ih => simp

theorem getD_oob (z : List Bool) : ∀ i : ℕ, z.length ≤ i → z.getD i false = false := by
  induction z with
  | nil => intro i _; simp
  | cons a z ih =>
    intro i h
    cases i with
    | zero => simp at h
    | succ i => simpa using ih i (by simpa using h)

