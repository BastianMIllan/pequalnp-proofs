    (zget_l x y ⟨j - 16, hl16⟩).symm.trans zj'⟩

theorem dir1 (x y : Fin 16 → Bool) (h1 : sem (List.ofFn x ++ List.ofFn y) D1 = true) (h2 : sem (List.ofFn x ++ List.ofFn y) D2 = true) :
