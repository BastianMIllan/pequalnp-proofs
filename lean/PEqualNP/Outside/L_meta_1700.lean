theorem inc_of_mono (x y : Fin 16 → Bool) (m : List ℕ)
    (hall : m.all (fun i => (List.ofFn x ++ List.ofFn y).getD i false) = true) (h : hasInc m = true) :
    ∃ p : Fin 16, ∃ l : Fin 16, ((p : ℕ), (l : ℕ)) ∈ incL ∧ x p = true ∧ y l = true := by
